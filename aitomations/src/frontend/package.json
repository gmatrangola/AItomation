{
    "name": "aitomations-frontend",
    "private": true,
    "version": "1.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build --logLevel=warn",
        "build:verbose": "vite build",
        "build:fast": "NODE_ENV=production vite build --logLevel=error",
        "preview": "vite preview",
        "type-check": "vue-tsc --noEmit",
        "lint": "eslint . --ext .vue,.js,.ts --max-warnings 0",
        "lint:fix": "eslint . --ext .vue,.js,.ts --fix",
        "format": "prettier --write \"src/**/*.{js,ts,vue,json,css,scss}\"",
        "format:check": "prettier --check \"src/**/*.{js,ts,vue,json,css,scss}\"",
        "validate": "pnpm run type-check && pnpm run lint && pnpm run format:check"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "highlight.js": "^11.11.1",
        "marked": "^16.3.0",
        "uuid": "^13.0.0",
        "vue": "^3.5.22",
        "vue-router": "^4.5.1",
        "vuetify": "^3.10.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/highlight.js": "^10.1.0",
        "@types/marked": "^6.0.0",
        "@types/uuid": "^11.0.0",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vue/tsconfig": "^0.5.1",
        "@vueuse/integrations": "^13.9.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-vue": "^9.32.0",
        "prettier": "^3.4.2",
        "sass-embedded": "^1.83.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.19.1",
        "vite": "^5.4.20",
        "vite-plugin-vuetify": "^2.1.2",
        "vue-tsc": "^2.2.12"
    }
}