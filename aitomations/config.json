{
    "name": "AItomations Creator",
    "version": "0.1.0",
    "slug": "aitomations-creator",
    "description": "Create Home Assistant automations using LLMs like Gemini or Ollama.",
    "url": "https://github.com/glmatra/aitomations",
    "startup": "application",
    "init": false,
    "arch": [
        "aarch64",
        "amd64",
        "armhf",
        "armv7",
        "i386"
    ],
    "ports": {
        "8099/tcp": 8099
    },
    "ports_description": {
        "8099/tcp": "Web interface for AItomations Creator"
    },
    "ingress": true,
    "ingress_port": 8099,
    "ingress_entry": "/",
    "panel_icon": "mdi:robot",
    "hassio_api": true,
    "homeassistant_api": true,
    "auth_api": true,
    "host_network": true,
    "options": {
        "ollama_api_url": "http://ollama:11434/api/generate",
        "ollama_model": "llama3",
        "gemini_api_key": "",
        "gemini_model": "gemini-2.5-pro",
        "llm_provider": "gemini"
    },
    "schema": {
        "ollama_api_url": "str?",
        "ollama_model": "str?",
        "gemini_api_key": "password?",
        "gemini_model": "list(gemini-2.5-flash|gemini-2.5-pro)?",
        "llm_provider": "list(ollama|gemini)"
    }
}